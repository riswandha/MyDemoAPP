# ===== Android =====
DEVICE_NAME=emulator-5554
# Opsional: daftar serial `adb devices` dipisah koma untuk run PARALEL di banyak device sekaligus,
# mis. ANDROID_DEVICES=emulator-5554,emulator-5556. Kosongkan/1 device untuk mode sequential.
# Isi dengan serial device milikmu sendiri di .env lokal - jangan pernah commit serial asli.
ANDROID_DEVICES=
PLATFORM_VERSION=13

# ===== Aplikasi =====
# APP_PATH hanya diisi bila ingin install ulang APK. Bila app sudah terpasang, biarkan kosong.
APP_PATH=
APP_PACKAGE=com.saucelabs.mydemoapp.android
APP_ACTIVITY=com.saucelabs.mydemoapp.android.view.activities.SplashActivity

# ===== Appium server =====
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# ===== iOS =====
# Nilai di bawah adalah default yang dipakai kalau variabelnya dikosongkan (lihat utils/env.ts).
# IOS_UDID diisi dengan UDID simulator/device dari `xcrun simctl list devices`. Seperti serial Android,
# UDID milikmu sendiri hanya ditulis di .env lokal - jangan pernah commit UDID asli.
IOS_DEVICE_NAME=iPhone 17 Pro
IOS_PLATFORM_VERSION=26.5
IOS_UDID=
IOS_BUNDLE_ID=com.saucelabs.mydemo.app.ios
