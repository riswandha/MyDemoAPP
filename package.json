{
  "name": "android-native-automation",
  "version": "1.0.0",
  "description": "Native Android automation using TypeScript + WebdriverIO + Appium",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./config/wdio.android.conf.ts",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:login": "wdio run ./config/wdio.android.conf.ts --suite login",
    "test:catalog": "wdio run ./config/wdio.android.conf.ts --suite catalog",
    "test:cart": "wdio run ./config/wdio.android.conf.ts --suite cart",
    "test:checkout": "wdio run ./config/wdio.android.conf.ts --suite checkout",
    "test:menu": "wdio run ./config/wdio.android.conf.ts --suite menu",
    "test:smoke": "wdio run ./config/wdio.android.conf.ts --suite smoke",
    "typecheck": "tsc --noEmit",
    "appium": "appium",
    "ci:summary": "ts-node scripts/ci-step-summary.ts",
    "report:capture": "ts-node scripts/run-multidevice-reports.ts",
    "report:build": "ts-node scripts/build-collection-report.ts",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "android",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
